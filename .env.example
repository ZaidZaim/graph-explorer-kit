# Copy to .env and fill in. .env is gitignored.

# --- Neo4j ---
# Local Docker (see docker-compose.yml):
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=graphrag-demo
NEO4J_DATABASE=neo4j

# Aura instead — swap the URI and password, leave the rest:
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# Optional overrides. EMBEDDING_DIMENSIONS must match EMBEDDING_MODEL:
#   text-embedding-3-small -> 1536      text-embedding-3-large -> 3072
# Changing either after ingestion requires `graphrag-reset --yes` and a re-ingest.
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# LLM_MODEL=gpt-4.1-mini
