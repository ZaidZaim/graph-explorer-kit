# Copy to .env and fill in. .env is gitignored.

# --- Which corpus to load -----------------------------------------------
# A package under projects/ exposing PROJECT: ProjectSpec.
# Copy projects/example to start a new one.
GRAPHRAG_PROJECT=projects.vicecity

# --- Neo4j ---------------------------------------------------------------
# Local Docker (see docker-compose.yml):
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=graphrag-demo
NEO4J_DATABASE=neo4j

# Aura instead — swap the URI, username, password and database from the
# credentials file Aura gives you. Note that on some Aura instances the
# username and database are the instance id, not "neo4j".
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io

# --- OpenAI --------------------------------------------------------------
OPENAI_API_KEY=sk-...

# Optional. EMBEDDING_DIMENSIONS must match EMBEDDING_MODEL:
#   text-embedding-3-small -> 1536      text-embedding-3-large -> 3072
# Changing either after ingestion needs `graphrag-reset --yes` and a re-ingest.
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# LLM_MODEL=gpt-4.1-mini
