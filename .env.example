# Copy to .env and fill in. .env is gitignored.

# --- Which corpus to load -----------------------------------------------
# A package under projects/ exposing PROJECT: ProjectSpec.
# Copy projects/example to start a new one. A project that adopts a graph
# another tool built (see README, "Adopting an existing graph") needs
# `graphrag-adopt` before its first `graphrag-setup`.
GRAPHRAG_PROJECT=projects.vicecity

# --- Model provider ------------------------------------------------------
# azure  = Microsoft Foundry / Azure OpenAI (default)
# openai = api.openai.com
LLM_PROVIDER=azure

# --- Microsoft Foundry (LLM_PROVIDER=azure) ------------------------------
# Auth is Entra ID via DefaultAzureCredential: `az login` is enough and no
# secret is stored. Needs the "Cognitive Services OpenAI User" role on the
# resource. Set AZURE_OPENAI_API_KEY only where there is no Azure identity.
#
# Find your deployments with:
#   az cognitiveservices account list -o table
#   az cognitiveservices account deployment list -n <resource> -g <rg> -o table
AZURE_OPENAI_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT=<chat-deployment-name>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<embedding-deployment-name>
# AZURE_OPENAI_API_VERSION=2024-10-21

# Chat and embedding deployments often live on different resources — quota,
# region and model availability are all per-resource. Set this to send
# embeddings elsewhere; it defaults to AZURE_OPENAI_ENDPOINT.
# AZURE_OPENAI_EMBEDDING_ENDPOINT=https://<other-resource>.cognitiveservices.azure.com/

# entra (default) uses your az login. Set to `key` only where there is no
# Azure identity; an ambient AZURE_OPENAI_API_KEY is otherwise ignored on
# purpose, so a key exported for another resource cannot leak into these calls.
# AZURE_AUTH_MODE=entra
# AZURE_OPENAI_API_KEY=

# --- OpenAI (LLM_PROVIDER=openai) ----------------------------------------
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4.1-mini
# EMBEDDING_MODEL=text-embedding-3-small

# --- The agent (graphrag-agent, and `agent` in the explorer) -------------
# The Microsoft Agent Framework agent reuses AZURE_OPENAI_CHAT_DEPLOYMENT and
# the same Entra / key auth as everything else. It needs its own API version,
# though: AZURE_OPENAI_API_VERSION above is set for the neo4j-graphrag clients,
# which speak Chat Completions, and a GA version like 2024-10-21 has no
# /responses route at all. The agent therefore uses its own default.
#
# responses (default) is the framework's recommended client. Switch to
# chat-completions if your deployment or region does not serve /responses.
# AGENT_CHAT_API=responses
#
# Override the agent's API version only if you need to pin one.
# AGENT_AZURE_API_VERSION=preview

# --- Model behaviour -----------------------------------------------------
# EMBEDDING_DIMENSIONS must match the deployed embedding model:
#   text-embedding-3-small -> 1536      text-embedding-3-large -> 3072
# Changing it after ingestion needs `graphrag-reset --yes` and a re-ingest,
# because the vector index is created at a fixed width.
EMBEDDING_DIMENSIONS=1536
#
# Temperature is deliberately unset. Newer reasoning models (gpt-5-mini and
# friends) reject any value other than their default and return HTTP 400.
# Set it only if your chat deployment accepts it.
# LLM_TEMPERATURE=0

# --- Neo4j ---------------------------------------------------------------
# Local Docker (see docker-compose.yml):
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=graphrag-demo
NEO4J_DATABASE=neo4j

# Aura instead — take the URI, username, password and database from the
# credentials file Aura gives you. On some instances the username and
# database are the instance id, not "neo4j".
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
